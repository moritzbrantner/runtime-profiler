{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runtime-profiler.local/schemas/metrics.schema.json",
  "title": "runtime-profiler metrics v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "samples", "metrics"],
  "properties": {
    "schema_version": { "const": "runtime-profiler/metrics/v1" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sample" }
    },
    "metrics": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/metric" }
    }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iteration",
        "duration_ms",
        "max_rss_kib",
        "exit_code",
        "timed_out",
        "succeeded"
      ],
      "properties": {
        "iteration": { "type": "integer", "minimum": 1 },
        "duration_ms": { "type": "number", "minimum": 0 },
        "max_rss_kib": { "type": ["integer", "null"], "minimum": 0 },
        "exit_code": { "type": ["integer", "null"] },
        "timed_out": { "type": "boolean" },
        "succeeded": { "type": "boolean" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "unit", "preferred_direction", "statistics"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "preferred_direction": { "enum": ["lower", "higher"] },
        "statistics": { "$ref": "#/$defs/statistics" }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "minimum", "maximum", "mean", "median", "p95"],
      "properties": {
        "sample_count": { "type": "integer", "minimum": 1 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "mean": { "type": "number" },
        "median": { "type": "number" },
        "p95": { "type": "number" }
      }
    }
  }
}
