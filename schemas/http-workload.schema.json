{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runtime-profiler.local/schemas/http-workload.schema.json",
  "title": "runtime-profiler bounded HTTP workload evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "collector_version",
    "adapter_digest",
    "concurrency",
    "request_count_per_iteration",
    "fixture_setup_ms",
    "fixture_teardown_ms",
    "collector_wall_time_ms",
    "overhead_status",
    "batches",
    "samples"
  ],
  "properties": {
    "schema_version": {
      "const": "runtime-profiler/http-workload/v1"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "collector_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "adapter_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "request_count_per_iteration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "fixture_setup_ms": {
      "type": "number",
      "minimum": 0
    },
    "fixture_teardown_ms": {
      "type": "number",
      "minimum": 0
    },
    "collector_wall_time_ms": {
      "type": "number",
      "minimum": 0
    },
    "overhead_status": {
      "const": "not-isolated"
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "iteration",
          "wall_time_ms"
        ],
        "properties": {
          "iteration": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "wall_time_ms": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "iteration",
          "request_index",
          "endpoint_index",
          "status_code",
          "expected_status",
          "curl_exit_code",
          "duration_ms",
          "response_bytes",
          "succeeded"
        ],
        "properties": {
          "iteration": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "request_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999
          },
          "endpoint_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          },
          "status_code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 599
          },
          "expected_status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "curl_exit_code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0
          },
          "response_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "succeeded": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
