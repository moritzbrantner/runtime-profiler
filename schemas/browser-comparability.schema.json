{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runtime-profiler.local/schemas/browser-comparability.schema.json",
  "title": "runtime-profiler browser comparability v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reference_bundle_id",
    "candidate_bundle_id",
    "reference_source",
    "candidate_source",
    "status",
    "reasons",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "runtime-profiler/browser-comparability/v1" },
    "reference_bundle_id": { "type": "string", "minLength": 1 },
    "candidate_bundle_id": { "type": "string", "minLength": 1 },
    "reference_source": { "$ref": "#/$defs/sourceIdentity" },
    "candidate_source": { "$ref": "#/$defs/sourceIdentity" },
    "status": { "enum": ["comparable", "incomparable", "insufficient-evidence"] },
    "reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_sha", "dirty"],
      "properties": {
        "git_sha": { "type": ["string", "null"] },
        "dirty": { "type": ["boolean", "null"] }
      }
    }
  }
}
