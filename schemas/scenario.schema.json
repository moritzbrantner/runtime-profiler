{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runtime-profiler.local/schemas/scenario.schema.json",
  "title": "runtime-profiler scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "target"],
  "properties": {
    "schema_version": { "const": "runtime-profiler/scenario/v1" },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "target": { "$ref": "#/$defs/commandTarget" },
    "run": { "$ref": "#/$defs/run" },
    "collectors": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["process"] },
      "default": ["process"]
    }
  },
  "$defs": {
    "commandTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "program"],
      "properties": {
        "type": { "const": "command" },
        "program": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "working_directory": { "type": ["string", "null"] },
        "inherit_env": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "warmup_iterations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 1
        },
        "measurement_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 5
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "default": 30
        }
      }
    }
  }
}
