{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runtime-profiler.local/schemas/hotspots.schema.json",
  "title": "runtime-profiler hotspots v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "reason", "hotspots"],
  "properties": {
    "schema_version": { "const": "runtime-profiler/hotspots/v1" },
    "status": { "enum": ["collected", "not-collected"] },
    "reason": { "type": "string" },
    "collector": { "type": ["string", "null"] },
    "tool_version": { "type": ["string", "null"] },
    "event": { "type": ["string", "null"] },
    "metric": { "type": ["string", "null"] },
    "unit": { "type": ["string", "null"] },
    "sample_period": { "type": ["integer", "null"], "minimum": 1 },
    "symbolization_mode": { "type": ["string", "null"] },
    "target_toolchain_kind": { "type": ["string", "null"] },
    "target_toolchain_fingerprint_schema_version": { "type": ["string", "null"] },
    "target_toolchain_fingerprint": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "total_weight": { "type": "integer", "minimum": 0 },
    "total_samples": { "type": "integer", "minimum": 0 },
    "truncated": { "type": "boolean" },
    "hotspots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "source_file", "line", "evidence_ref"],
        "properties": {
          "id": { "type": "string" },
          "symbol": { "type": "string", "minLength": 1 },
          "source_file": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "dso": { "type": ["string", "null"] },
          "metric": { "type": "string" },
          "unit": { "type": "string" },
          "weight": { "type": "integer", "minimum": 0 },
          "samples": { "type": "integer", "minimum": 0 },
          "confidence": { "type": "string" },
          "evidence_ref": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}