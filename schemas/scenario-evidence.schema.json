{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runtime-profiler.local/schemas/scenario-evidence.schema.json",
  "title": "runtime-profiler redacted scenario evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "digest", "target", "run", "collectors"],
  "properties": {
    "schema_version": { "const": "runtime-profiler/scenario-evidence/v1" },
    "id": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_type",
        "program",
        "argument_count",
        "working_directory_set",
        "inherited_environment_names"
      ],
      "properties": {
        "target_type": { "const": "command" },
        "program": { "type": "string", "minLength": 1 },
        "argument_count": { "type": "integer", "minimum": 0 },
        "working_directory_set": { "type": "boolean" },
        "inherited_environment_names": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "run": { "$ref": "scenario.schema.json#/$defs/run" },
    "collectors": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["process", "native-perf"] }
    }
  }
}
