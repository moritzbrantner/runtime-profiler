{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runtime-profiler.local/schemas/scenario-evidence.schema.json",
  "title": "runtime-profiler redacted scenario evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "digest", "target", "run", "collectors"],
  "properties": {
    "schema_version": { "const": "runtime-profiler/scenario-evidence/v1" },
    "id": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target": {
      "oneOf": [
        { "$ref": "#/$defs/commandTargetEvidence" },
        { "$ref": "#/$defs/browserJourneyTargetEvidence" },
        { "$ref": "#/$defs/httpWorkloadTargetEvidence" }
      ]
    },
    "run": { "$ref": "scenario.schema.json#/$defs/run" },
    "collectors": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["process", "native-perf", "browser-chromium", "http-curl"] }
    }
  },
  "$defs": {
    "httpWorkloadTargetEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_type",
        "request_count",
        "endpoint_count",
        "concurrency",
        "request_timeout_seconds",
        "fixture_program",
        "inherited_environment_names"
      ],
      "properties": {
        "target_type": {
          "const": "http-workload"
        },
        "request_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "endpoint_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "request_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "fixture_program": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "inherited_environment_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "commandTargetEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_type",
        "program",
        "argument_count",
        "working_directory_set",
        "inherited_environment_names"
      ],
      "properties": {
        "target_type": { "const": "command" },
        "program": { "type": "string", "minLength": 1 },
        "argument_count": { "type": "integer", "minimum": 0 },
        "working_directory_set": { "type": "boolean" },
        "inherited_environment_names": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "browserJourneyTargetEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_type",
        "module",
        "working_directory_set",
        "inherited_environment_names"
      ],
      "properties": {
        "target_type": { "const": "browser-journey" },
        "module": { "type": "string", "minLength": 1 },
        "working_directory_set": { "type": "boolean" },
        "inherited_environment_names": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
