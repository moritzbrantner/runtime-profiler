{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runtime-profiler.local/schemas/agent-guidance.schema.json",
  "title": "runtime-profiler agent guidance v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "observations", "constraints", "evidence_refs"],
  "properties": {
    "schema_version": { "const": "runtime-profiler/agent-guidance/v1" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "evidence_ref"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "evidence_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } }
  }
}
