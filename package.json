{
  "name": "runtime-profiler-pages",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck:pages": "tsc --noEmit -p tsconfig.pages.json",
    "compile:pages": "tsc -p tsconfig.pages.json",
    "build:pages": "bash scripts/build_pages.sh",
    "test:pages": "node --test tests/*.test.mjs",
    "verify:pages": "npm run build:pages && npm run test:pages"
  },
  "devDependencies": {
    "@moritzbrantner/github-pages-template": "git+https://github.com/moritzbrantner/github-pages-template.git#abff6089e687d2c1b8d5afdfe7ef6f59fd825f74",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "github:moritzbrantner/github-pages-template": true
  }
}
